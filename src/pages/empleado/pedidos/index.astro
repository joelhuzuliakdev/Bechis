---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { createSupabaseServerClient } from "@/lib/supabase/server";
import { fetchActiveOrders } from "@/lib/orders/fetchOrders";
import { KANBAN_COLUMNS, ORDER_STATUS_LABELS } from "@/lib/orders/orderStatus";

const profile = Astro.locals.profile;
const supabase = createSupabaseServerClient(Astro.cookies);
const orders = await fetchActiveOrders(supabase);

const COLUMN_EMOJIS: Record<string, string> = {
  pedidos: "🆕",
  confirmado: "✅",
  en_proceso: "👨‍🍳",
  listo_para_retirar: "📦",
  finalizado: "🏁",
};

function ordersForColumn(status: string) {
  return orders.filter((o) => o.status === status);
}
---

<AdminLayout role={profile.role} userName={profile.fullName || profile.email || "Usuario"}>
  <div class="mb-4 flex items-center justify-between">
    <h1 class="font-display text-xl text-gray-900">Pedidos</h1>
    <a
      href="/empleado/pedidos/cancelados"
      class="text-xs font-semibold text-gray-500 underline hover:text-gray-700"
    >
      Ver cancelados
    </a>
  </div>

  <div class="overflow-x-auto pb-4">
    <div class="grid grid-flow-col auto-cols-[minmax(230px,1fr)] gap-3">
      {
        KANBAN_COLUMNS.map((status) => (
          <div class="rounded-lg bg-gray-50 p-3">
            <div class="mb-3 flex items-center justify-between">
              <h2 class="text-sm font-bold text-gray-700">
                {COLUMN_EMOJIS[status]} {ORDER_STATUS_LABELS[status]}
              </h2>
              <span
                data-count-for={`column-${status}`}
                class="rounded-full bg-gray-200 px-2 py-0.5 text-xs font-bold text-gray-600"
              >
                {ordersForColumn(status).length}
              </span>
            </div>
            <div id={`column-${status}`} class="min-h-[120px]" />
          </div>
        ))
      }
    </div>
  </div>
</AdminLayout>

<script define:vars={{ initialOrdersJson: JSON.stringify(orders) }}>
  window.__initialOrdersJson = initialOrdersJson;
</script>
<script>
  import { attachKanbanBoard } from "@/components/employee/KanbanBoard";
  attachKanbanBoard(window.__initialOrdersJson);
</script>