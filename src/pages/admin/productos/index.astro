---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { createSupabaseServerClient } from "@/lib/supabase/server";
import { listProductsAdmin, listCategories } from "@/lib/catalog/fetchCatalogAdmin";

const profile = Astro.locals.profile!;
const supabase = createSupabaseServerClient(Astro.cookies);
const [products, categories] = await Promise.all([listProductsAdmin(supabase), listCategories(supabase)]);

const money = (n: number) =>
    new Intl.NumberFormat("es-AR", { style: "currency", currency: "ARS", maximumFractionDigits: 0 }).format(n);

// Filtros (por URL, así sobreviven a recargar la página).
const categoriaParam = Astro.url.searchParams.get("categoria") ?? "todas";
const estadoParam = Astro.url.searchParams.get("estado") ?? "todos"; // todos | activos | suspendidos

const byEstado = products.filter((p) =>
    estadoParam === "activos" ? p.active : estadoParam === "suspendidos" ? !p.active : true
);

// Un grupo por categoría (en el orden del admin de Categorías) y, si hace
// falta, uno para productos sin categoría.
const groupDefs = [...categories.map((c) => ({ id: c.id, name: c.name }))];
if (byEstado.some((p) => !p.categoryId) || products.some((p) => !p.categoryId)) {
    groupDefs.push({ id: "sin-categoria", name: "Sin categoría" });
}
const groups = groupDefs.map((g) => ({
    ...g,
    items: byEstado.filter((p) => (p.categoryId ?? "sin-categoria") === g.id),
}));

const visibleGroups =
    categoriaParam === "todas" ? groups.filter((g) => g.items.length > 0) : groups.filter((g) => g.id === categoriaParam);
const totalVisible = visibleGroups.reduce((sum, g) => sum + g.items.length, 0);

const href = (categoria: string, estado: string) => `?categoria=${categoria}&estado=${estado}`;
const estados = [
    { value: "todos", label: "Todos" },
    { value: "activos", label: "Activos" },
    { value: "suspendidos", label: "Suspendidos" },
];
---

<AdminLayout title="Productos" role={profile.role} userName={profile.fullName || profile.email || "Usuario"}>
    <div class="mb-5 flex items-center justify-between">
        <p class="text-sm text-gray-500">Catálogo de productos.</p>
        <a href="/admin/productos/nuevo" class="rounded-md bg-bechis-yellow px-4 py-2 text-sm font-bold text-ink">
            + Nuevo producto
        </a>
    </div>

    <!-- Filtro por categoría -->
    <div class="mb-3 flex flex-wrap gap-2">
        <a
            href={href("todas", estadoParam)}
            class:list={[
                "rounded-full px-3.5 py-1.5 text-sm font-medium transition-colors",
                categoriaParam === "todas" ? "bg-ink text-white" : "bg-white text-gray-600 hover:bg-gray-100",
            ]}
        >
            Todas ({byEstado.length})
        </a>
        {
            groups.map((g) => (
                <a
                    href={href(g.id, estadoParam)}
                    class:list={[
                        "rounded-full px-3.5 py-1.5 text-sm font-medium transition-colors",
                        categoriaParam === g.id ? "bg-ink text-white" : "bg-white text-gray-600 hover:bg-gray-100",
                    ]}
                >
                    {g.name} ({g.items.length})
                </a>
            ))
        }
    </div>

    <!-- Filtro por estado -->
    <div class="mb-5 flex flex-wrap items-center gap-2">
        <span class="text-xs font-medium uppercase tracking-wide text-gray-400">Estado</span>
        {
            estados.map((e) => (
                <a
                    href={href(categoriaParam, e.value)}
                    class:list={[
                        "rounded-full px-3 py-1 text-xs font-semibold transition-colors",
                        estadoParam === e.value ? "bg-bechis-yellow text-ink" : "bg-white text-gray-500 hover:bg-gray-100",
                    ]}
                >
                    {e.label}
                </a>
            ))
        }
    </div>

    {
        totalVisible === 0 && categoriaParam === "todas" ? (
            <div class="rounded-lg border border-gray-200 bg-white px-4 py-10 text-center text-gray-400">
                No hay productos con este filtro.
            </div>
        ) : (
            visibleGroups.map((g) => (
                <section class="mb-6">
                    <h3 class="mb-2 text-sm font-semibold text-gray-900">
                        {g.name} <span class="font-normal text-gray-400">· {g.items.length}</span>
                    </h3>
                    <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white">
                        <table class="w-full text-left text-sm">
                            <thead class="border-b border-gray-200 bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
                                <tr>
                                    <th class="px-4 py-3">Producto</th>
                                    <th class="px-4 py-3 text-right">Precio</th>
                                    <th class="px-4 py-3 text-right">Stock</th>
                                    <th class="px-4 py-3">Estado</th>
                                    <th class="px-4 py-3 text-right">Acciones</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                {g.items.length === 0 ? (
                                    <tr>
                                        <td colspan="5" class="px-4 py-8 text-center text-gray-400">
                                            No hay productos en esta categoría.
                                        </td>
                                    </tr>
                                ) : (
                                    g.items.map((p) => (
                                        <tr data-product-id={p.id} data-product-name={p.name} class:list={[p.active ? "" : "bg-gray-50/60"]}>
                                            <td class="px-4 py-3 font-medium text-gray-900">
                                                <div class:list={["flex items-center gap-2.5", p.active ? "" : "opacity-60"]}>
                                                    <div class="flex h-9 w-9 items-center justify-center overflow-hidden rounded-md bg-gray-100 text-base">
                                                        {p.imageUrl ? <img src={p.imageUrl} class="h-full w-full object-cover" /> : "🍔"}
                                                    </div>
                                                    {p.name}
                                                </div>
                                            </td>
                                            <td class="px-4 py-3 text-right text-gray-900">{money(p.price)}</td>
                                            <td class="px-4 py-3 text-right text-gray-500">
                                                <span class={p.stock <= p.minStock ? "font-semibold text-danger" : ""}>{p.stock}</span>
                                            </td>
                                            <td class="px-4 py-3">
                                                {p.active ? (
                                                    <span class="rounded-full bg-green-100 px-2.5 py-1 text-xs font-bold text-green-700">Activo</span>
                                                ) : (
                                                    <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-bold text-amber-700">Suspendido</span>
                                                )}
                                            </td>
                                            <td class="whitespace-nowrap px-4 py-3 text-right">
                                                <a href={`/admin/productos/${p.id}/editar`} class="rounded-md border border-gray-200 px-3 py-1.5 text-xs font-semibold text-gray-600">
                                                    Editar
                                                </a>
                                                <button
                                                    type="button"
                                                    data-action="toggle-active"
                                                    data-active={p.active ? "true" : "false"}
                                                    class:list={[
                                                        "ml-1.5 rounded-md border px-3 py-1.5 text-xs font-semibold",
                                                        p.active ? "border-amber-200 text-amber-700" : "border-green-200 text-green-700",
                                                    ]}
                                                >
                                                    {p.active ? "Suspender" : "Reactivar"}
                                                </button>
                                            </td>
                                        </tr>
                                    ))
                                )}
                            </tbody>
                        </table>
                    </div>
                </section>
            ))
        )
    }

    <script>
        function notify(message: string) {
            const el = document.getElementById("toast");
            if (!el) {
                alert(message);
                return;
            }
            el.textContent = message;
            el.classList.remove("opacity-0", "translate-y-4");
            setTimeout(() => el.classList.add("opacity-0", "translate-y-4"), 2500);
        }

        document.querySelectorAll<HTMLElement>("[data-product-id]").forEach((row) => {
            const id = row.dataset.productId!;
            const name = row.dataset.productName ?? "este producto";

            row.querySelector("[data-action='toggle-active']")?.addEventListener("click", async (e) => {
                const btn = e.currentTarget as HTMLButtonElement;
                const suspending = btn.dataset.active === "true";

                if (
                    suspending &&
                    !confirm(`¿Suspender "${name}"?\n\nDejará de aparecer en la tienda y no se va a poder pedir hasta que lo reactives.`)
                ) {
                    return;
                }

                btn.disabled = true;
                const res = await fetch(`/api/products/${id}`, {
                    method: "PATCH",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ active: !suspending }),
                });

                if (res.ok) {
                    location.reload();
                    return;
                }
                const result = await res.json().catch(() => ({}));
                notify(result.error ?? "No se pudo actualizar el producto.");
                btn.disabled = false;
            });
        });
    </script>
</AdminLayout>