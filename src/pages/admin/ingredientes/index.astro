---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { createSupabaseServerClient } from "@/lib/supabase/server";
import { listGlobalIngredients } from "@/lib/catalog/fetchCatalogAdmin";
import { formatQty, UNIT_LABEL } from "@/lib/stock/units";

const profile = Astro.locals.profile!;
const supabase = createSupabaseServerClient(Astro.cookies);
const ingredients = await listGlobalIngredients(supabase);

const UNIT_OPTIONS = [
    { value: "unidad", label: "Unidades" },
    { value: "g", label: "Gramos (el stock se carga en kg)" },
    { value: "ml", label: "Mililitros (el stock se carga en litros)" },
];
---

<AdminLayout title="Ingredientes" role={profile.role} userName={profile.fullName || profile.email || "Usuario"}>
    <div class="mb-5 rounded-lg border border-gray-200 bg-white p-4">
        <h3 class="mb-3 text-sm font-semibold text-gray-900">Nuevo ingrediente</h3>
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-6">
        <div class="lg:col-span-2">
            <label class="mb-1 block text-xs text-gray-500">Nombre</label>
            <input id="new-name" type="text" placeholder="Ej: Medallón de carne" class="w-full rounded-md border border-gray-200 px-3 py-2 text-sm" />
        </div>
        <div>
            <label class="mb-1 block text-xs text-gray-500">Se mide en</label>
            <select id="new-unit" class="w-full rounded-md border border-gray-200 px-2 py-2 text-sm">
                {UNIT_OPTIONS.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
        </div>
        <div>
            <label class="mb-1 block text-xs text-gray-500">Precio extra</label>
            <input id="new-extra-price" type="number" min="0" step="1" placeholder="0" class="w-full rounded-md border border-gray-200 px-3 py-2 text-sm" />
        </div>
        <div>
            <label id="new-extra-qty-label" class="mb-1 block text-xs text-gray-500">Consumo por extra (u.)</label>
            <input id="new-extra-qty" type="number" min="0" step="any" value="1" class="w-full rounded-md border border-gray-200 px-3 py-2 text-sm" />
        </div>
        <div>
            <label id="new-stock-label" class="mb-1 block text-xs text-gray-500">Stock inicial (u.)</label>
            <input id="new-stock" type="number" min="0" step="any" placeholder="0" class="w-full rounded-md border border-gray-200 px-3 py-2 text-sm" />
        </div>
        </div>
        <div class="mt-3 flex items-center gap-3">
            <button id="create-submit" type="button" class="rounded-md bg-bechis-yellow px-4 py-2 text-sm font-bold text-ink">
                Agregar
            </button>
            <p id="create-error" class="text-xs text-red-600"></p>
        </div>
        <p class="mt-2 text-xs text-gray-400">
            "Consumo por extra" = cuánto de este ingrediente se descuenta cada vez que un cliente lo agrega como extra.
            El stock se mueve después desde la pantalla Stock.
        </p>
    </div>

    <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white">
        <table class="w-full text-left text-sm">
        <thead class="border-b border-gray-200 bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
            <tr>
            <th class="px-4 py-3">Nombre</th>
            <th class="px-4 py-3">Se mide en</th>
            <th class="px-4 py-3">Precio extra</th>
            <th class="px-4 py-3">Consumo por extra</th>
            <th class="px-4 py-3">Stock actual</th>
            <th class="px-4 py-3">Estado</th>
            <th class="px-4 py-3 text-right">Guardar</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            {
            ingredients.length === 0 ? (
                <tr><td colspan="7" class="px-4 py-8 text-center text-gray-400">No hay ingredientes cargados.</td></tr>
            ) : (
                ingredients.map((ing) => (
                <tr data-ingredient-id={ing.id}>
                    <td class="px-4 py-2">
                    <input data-role="name" type="text" value={ing.name} class="w-full min-w-[10rem] rounded-md border border-gray-200 px-2 py-1.5 text-sm" />
                    </td>
                    <td class="px-4 py-2">
                    <select data-role="unit" class="rounded-md border border-gray-200 px-2 py-1.5 text-sm">
                        <option value="unidad" selected={ing.unit === "unidad"}>Unidades</option>
                        <option value="g" selected={ing.unit === "g"}>Gramos</option>
                        <option value="ml" selected={ing.unit === "ml"}>Mililitros</option>
                    </select>
                    </td>
                    <td class="px-4 py-2">
                    <input data-role="extra-price" type="number" min="0" step="1" value={ing.extraPrice} class="w-24 rounded-md border border-gray-200 px-2 py-1.5 text-sm" />
                    </td>
                    <td class="px-4 py-2 whitespace-nowrap">
                    <input data-role="extra-qty" type="number" min="0" step="any" value={ing.extraQuantity} class="w-20 rounded-md border border-gray-200 px-2 py-1.5 text-sm" />
                    <span class="ml-1 text-xs text-gray-400">{UNIT_LABEL[ing.unit]}</span>
                    </td>
                    <td class="px-4 py-2 whitespace-nowrap text-gray-700">{formatQty(ing.stock, ing.unit)}</td>
                    <td class="px-4 py-2">
                    <button
                        type="button"
                        data-action="toggle-active"
                        data-active={ing.active ? "true" : "false"}
                        class:list={["rounded-full px-2.5 py-1 text-xs font-bold", ing.active ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-500"]}
                    >
                        {ing.active ? "Activo" : "Inactivo"}
                    </button>
                    </td>
                    <td class="px-4 py-2 text-right">
                    <button data-action="save" type="button" class="rounded-md border border-gray-200 px-3 py-1.5 text-xs font-semibold text-gray-600">
                        Guardar
                    </button>
                    </td>
                </tr>
                ))
            )
            }
        </tbody>
        </table>
    </div>

    <script>
        import { inputUnitsFor, toBaseUnit, UNIT_LABEL, type StockUnit } from "@/lib/stock/units";

        function toast(message: string) {
            const el = document.getElementById("toast");
            if (!el) return;
            el.textContent = message;
            el.classList.remove("opacity-0", "translate-y-4");
            setTimeout(() => el.classList.add("opacity-0", "translate-y-4"), 3500);
        }

        // --- Alta ---------------------------------------------------------
        const newUnit = document.getElementById("new-unit") as HTMLSelectElement;
        const newStockLabel = document.getElementById("new-stock-label")!;
        const newExtraQtyLabel = document.getElementById("new-extra-qty-label")!;

        function syncCreateLabels() {
            const unit = newUnit.value as StockUnit;
            newStockLabel.textContent = `Stock inicial (${inputUnitsFor(unit)[0].label})`;
            newExtraQtyLabel.textContent = `Consumo por extra (${UNIT_LABEL[unit]})`;
        }
        newUnit.addEventListener("change", syncCreateLabels);
        syncCreateLabels();

        document.getElementById("create-submit")?.addEventListener("click", async () => {
        const errorEl = document.getElementById("create-error")!;
        errorEl.textContent = "";
        const name = (document.getElementById("new-name") as HTMLInputElement).value.trim();
        const unit = newUnit.value as StockUnit;
        const extraPrice = Number((document.getElementById("new-extra-price") as HTMLInputElement).value || 0);
        const extraQuantity = Number((document.getElementById("new-extra-qty") as HTMLInputElement).value || 0);
        // El stock inicial se escribe en kg/l (o unidades) y se guarda en la unidad base.
        const stock = toBaseUnit(
            Number((document.getElementById("new-stock") as HTMLInputElement).value || 0),
            inputUnitsFor(unit)[0].factor
        );

        if (name.length < 2) {
            errorEl.textContent = "Ponele un nombre al ingrediente.";
            return;
        }

        const res = await fetch("/api/ingredients/create", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ name, unit, extraPrice, extraQuantity, stock, minStock: 0, active: true }),
        });
        const result = await res.json().catch(() => ({}));
        if (!res.ok) {
            errorEl.textContent = result.error ?? "No se pudo crear.";
            return;
        }
        if (result.warning) {
            alertThenReload(result.warning);
            return;
        }
        location.reload();
        });

        function alertThenReload(message: string) {
            toast(message);
            setTimeout(() => location.reload(), 3600);
        }

        // --- Filas existentes -----------------------------------------------
        document.querySelectorAll<HTMLElement>("[data-ingredient-id]").forEach((row) => {
        const id = row.dataset.ingredientId!;

        row.querySelector("[data-action='toggle-active']")?.addEventListener("click", async (e) => {
            const btn = e.currentTarget as HTMLButtonElement;
            const nextActive = btn.dataset.active !== "true";
            const res = await fetch(`/api/ingredients/${id}`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ active: nextActive }),
            });
            if (res.ok) location.reload();
            else toast("No se pudo cambiar el estado.");
        });

        row.querySelector("[data-action='save']")?.addEventListener("click", async () => {
            const name = row.querySelector<HTMLInputElement>("[data-role='name']")!.value.trim();
            const unit = row.querySelector<HTMLSelectElement>("[data-role='unit']")!.value;
            const extraPrice = Number(row.querySelector<HTMLInputElement>("[data-role='extra-price']")!.value || 0);
            const extraQuantity = Number(row.querySelector<HTMLInputElement>("[data-role='extra-qty']")!.value || 0);

            const res = await fetch(`/api/ingredients/${id}`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ name, unit, extraPrice, extraQuantity }),
            });
            if (res.ok) {
                location.reload();
                return;
            }
            const result = await res.json().catch(() => ({}));
            toast(result.error ?? "No se pudo guardar el ingrediente.");
        });
        });
    </script>
</AdminLayout>