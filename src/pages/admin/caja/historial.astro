---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { createSupabaseServerClient } from "@/lib/supabase/server";
import { getCashRegisterHistory } from "@/lib/cash/fetchCashRegister";
import { getPresetRange, parseCustomRange, toDateInputValue, type DateRangePreset } from "@/lib/format/dateRanges";

const profile = Astro.locals.profile!;
const supabase = createSupabaseServerClient(Astro.cookies);

const url = Astro.url;
const presetParam = (url.searchParams.get("range") as DateRangePreset) || "mes";
const fromParam = url.searchParams.get("from") ?? "";
const toParam = url.searchParams.get("to") ?? "";

const range =
  presetParam === "personalizado" && fromParam && toParam
    ? parseCustomRange(fromParam, toParam)
    : getPresetRange(presetParam);

const history = await getCashRegisterHistory(supabase, range.from, range.to);

const money = (n: number | null) =>
  n === null ? "—" : new Intl.NumberFormat("es-AR", { style: "currency", currency: "ARS", maximumFractionDigits: 0 }).format(n);

const filters: { value: DateRangePreset; label: string }[] = [
  { value: "hoy", label: "Hoy" },
  { value: "semana", label: "Esta semana" },
  { value: "mes", label: "Este mes" },
];
---

<AdminLayout title="Historial de caja" role={profile.role} userName={profile.fullName || profile.email || "Admin"}>
  <div class="mb-5 flex items-center justify-between">
    <a href="/admin/caja" class="text-sm font-medium text-gray-500 underline">← Volver a Caja</a>
  </div>

  <div class="mb-5 flex flex-wrap items-center gap-2">
    {
      filters.map((f) => (
        <a
          href={`?range=${f.value}`}
          class:list={[
            "rounded-full px-3.5 py-1.5 text-sm font-medium transition-colors",
            presetParam === f.value ? "bg-ink text-white" : "bg-white text-gray-600 hover:bg-gray-100",
          ]}
        >
          {f.label}
        </a>
      ))
    }
    <form method="GET" class="flex items-center gap-1.5 rounded-full bg-white px-2 py-1">
      <input type="hidden" name="range" value="personalizado" />
      <input type="date" name="from" value={presetParam === "personalizado" ? fromParam : toDateInputValue(range.from)} class="rounded-md border-none bg-transparent px-1 py-1 text-sm text-gray-700 outline-none" />
      <span class="text-gray-400">–</span>
      <input type="date" name="to" value={presetParam === "personalizado" ? toParam : toDateInputValue(range.to)} class="rounded-md border-none bg-transparent px-1 py-1 text-sm text-gray-700 outline-none" />
      <button type="submit" class:list={["rounded-full px-3 py-1 text-sm font-medium", presetParam === "personalizado" ? "bg-ink text-white" : "bg-gray-100 text-gray-600"]}>
        Aplicar
      </button>
    </form>
  </div>

  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-gray-200 bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
        <tr>
          <th class="whitespace-nowrap px-4 py-3">Apertura</th>
          <th class="whitespace-nowrap px-4 py-3">Cierre</th>
          <th class="whitespace-nowrap px-4 py-3">Abrió</th>
          <th class="whitespace-nowrap px-4 py-3">Cerró</th>
          <th class="whitespace-nowrap px-4 py-3 text-right">Inicial</th>
          <th class="whitespace-nowrap px-4 py-3 text-right">Esperado</th>
          <th class="whitespace-nowrap px-4 py-3 text-right">Real</th>
          <th class="whitespace-nowrap px-4 py-3 text-right">Diferencia</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        {
          history.length === 0 ? (
            <tr>
              <td colspan="8" class="px-4 py-10 text-center text-gray-400">
                No hay cajas cerradas en este período.
              </td>
            </tr>
          ) : (
            history.map((h) => (
              <tr>
                <td class="whitespace-nowrap px-4 py-3 text-gray-500">
                  {new Date(h.openedAt).toLocaleString("es-AR", { day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" })}
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-gray-500">
                  {h.closedAt ? new Date(h.closedAt).toLocaleString("es-AR", { day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" }) : "—"}
                </td>
                <td class="px-4 py-3 text-gray-700">{h.openedByName ?? "—"}</td>
                <td class="px-4 py-3 text-gray-700">{h.closedByName ?? "—"}</td>
                <td class="px-4 py-3 text-right text-gray-900">{money(h.openingAmount)}</td>
                <td class="px-4 py-3 text-right text-gray-900">{money(h.expectedTotal)}</td>
                <td class="px-4 py-3 text-right text-gray-900">{money(h.realAmount)}</td>
                <td class:list={["px-4 py-3 text-right font-semibold", (h.difference ?? 0) < 0 ? "text-red-600" : (h.difference ?? 0) > 0 ? "text-green-600" : "text-gray-500"]}>
                  {h.difference === null ? "—" : (h.difference > 0 ? "+" : "") + money(h.difference)}
                </td>
              </tr>
            ))
          )
        }
      </tbody>
    </table>
  </div>
</AdminLayout>