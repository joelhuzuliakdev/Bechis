---
import PublicLayout from "@/layouts/PublicLayout.astro";
import CategoryCard from "@/components/public/CategoryCard.astro";
import ProductCard from "@/components/public/ProductCard.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import { supabasePublic } from "@/lib/supabase/public";
import type { Category } from "@/types";

const { data: categories, error: categoriesError } = await supabasePublic
	.from("categories")
	.select("id, name, slug, sort_order, active, icon_emoji, accent_color")
	.eq("active", true)
	.order("sort_order", { ascending: true })
	.returns<Category[]>();

if (categoriesError) console.error("Error cargando categorías:", categoriesError.message);

const { data: featuredRaw, error: featuredError } = await supabasePublic
	.from("products")
	.select("id, name, description, price, image_url, active, categories ( slug )")
	.eq("active", true)
	.order("created_at", { ascending: false })
	.limit(6);

if (featuredError) console.error("Error cargando destacados:", featuredError.message);

const featuredProducts = (featuredRaw ?? []).map((p: any) => ({
	id: p.id,
	name: p.name,
	description: p.description,
	price: p.price,
	image_url: p.image_url,
	categorySlug: p.categories?.slug ?? "otros",
}));

const steps = [
	{ emoji: "🍔", title: "Elegí tus productos", text: "Recorré el catálogo y armá tu pedido a tu gusto." },
	{ emoji: "🧾", title: "Personalizá y confirmá", text: "Sumá o sacá ingredientes, elegí envío o retiro." },
	{ emoji: "🛵", title: "Recibilo o retiralo", text: "Te avisamos apenas tu pedido está en camino o listo." },
];
---

<PublicLayout title="Bechis — Pedí online">
	<!-- HERO -->
	<section id="categorias" class="bg-ink px-4 pb-12 pt-8 md:px-8 md:pt-10">
		<div class="mx-auto w-full max-w-7xl">
			<span class="mb-4 inline-flex items-center gap-1.5 rounded-full bg-bechis-yellow/15 px-3 py-1 text-xs font-semibold text-bechis-yellow">
				<span class="h-1.5 w-1.5 rounded-full bg-bechis-yellow"></span>
				Estamos abiertos — pedidos hasta las 00:30
			</span>

			<h1 class="mb-1.5 font-display text-2xl text-white md:text-3xl">Elegí tu categoría</h1>
			<p class="mb-7 text-sm text-white/60">Hamburguesas, papas, combos y más — armadas al momento.</p>

			<div class="grid grid-cols-2 gap-3.5 sm:grid-cols-3 lg:grid-cols-5 xl:grid-cols-6">
				{
				categories && categories.length > 0 ? (
					categories.map((cat) => (
					<CategoryCard name={cat.name} slug={cat.slug} emoji={cat.icon_emoji} accentColor={cat.accent_color} />
					))
				) : (
					<div class="col-span-2 sm:col-span-3 lg:col-span-5 xl:col-span-6">
					<EmptyState message="Todavía no hay categorías cargadas." emoji="🍔" />
					</div>
				)
				}
			</div>
		</div>
	</section>

	<!-- DESTACADOS: un tono de negro más claro que el hero, para separar sin salir de la paleta -->
	<section class="border-t border-ink-muted bg-ink-soft px-4 py-12 md:px-8">
		<div class="mx-auto w-full max-w-7xl">
		<h2 class="mb-1 font-display text-xl text-white md:text-2xl">Los favoritos de Bechis</h2>
		<p class="mb-6 text-sm text-white/60">Una selección para arrancar rápido.</p>

		{
			featuredProducts.length > 0 ? (
			<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
				{featuredProducts.map((p) => (
				<ProductCard
					id={p.id}
					name={p.name}
					description={p.description}
					price={p.price}
					imageUrl={p.image_url}
					categorySlug={p.categorySlug}
				/>
				))}
			</div>
			) : (
			<EmptyState message="Todavía no hay productos cargados." emoji="🍔" />
			)
		}
		</div>
	</section>

	<!-- CÓMO PEDÍS -->
	<section class="border-t border-ink-muted bg-ink px-4 py-14 md:px-8">
		<div class="mx-auto w-full max-w-4xl">
		<h2 class="mb-10 text-center font-display text-xl text-white md:text-2xl">¿Cómo hacés tu pedido?</h2>

		<div class="relative grid grid-cols-1 gap-10 sm:grid-cols-3 sm:gap-6">
			<!-- Línea punteada que conecta los 3 pasos (solo desktop) -->
			<div
			class="absolute top-7 hidden h-px border-t border-dashed border-white/15 sm:block"
			style="left:16.666%; right:16.666%;"
			>
			</div>

			{
			steps.map((step, i) => (
				<div class="relative flex flex-col items-center text-center">
				<div class="relative z-10 mb-4">
					<span class="flex h-14 w-14 items-center justify-center rounded-full border border-white/10 bg-ink-soft text-2xl">
					{step.emoji}
					</span>
					<span class="absolute -right-1 -top-1 flex h-6 w-6 items-center justify-center rounded-full bg-bechis-yellow text-[11px] font-bold text-ink">
					{i + 1}
					</span>
				</div>
				<h3 class="mb-1 text-[15px] font-semibold text-white">{step.title}</h3>
				<p class="max-w-[220px] text-sm text-white/60">{step.text}</p>
				</div>
			))
			}
		</div>

		<div class="mt-12 text-center">
			<a
			href="#categorias"
			class="inline-flex items-center gap-2 rounded-full bg-bechis-yellow px-6 py-3 text-sm font-bold text-ink transition-transform hover:scale-[1.03]"
			>
			Ver catálogo completo
			</a>
		</div>
		</div>
	</section>
</PublicLayout>