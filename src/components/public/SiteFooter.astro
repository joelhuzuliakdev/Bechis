---
// Footer estático por ahora (dirección/horarios de ejemplo). Cuando
// tengas esos datos reales de Bechis, lo más prolijo es moverlos a
// una tabla `business_settings` administrable desde el panel, en vez
// de hardcodearlos acá — queda anotado para cuando lleguemos al admin.
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-bechis-yellow bg-ink px-4 py-10 text-white md:px-8">
    <div class="mx-auto flex w-full max-w-7xl flex-col gap-8 md:flex-row md:justify-between">
        <div>
        <div class="mb-2 flex items-center gap-2">
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-bechis-yellow text-xs font-display text-ink">
            B
            </span>
            <span class="font-display text-base tracking-tight">BECHIS</span>
        </div>
        <p class="max-w-xs text-sm text-white/60">
            Hamburguesas armadas al momento, con ingredientes elegidos por vos.
        </p>
        </div>

        <div class="grid grid-cols-2 gap-8 text-sm sm:grid-cols-3">
        <div>
            <h4 class="mb-2 font-semibold text-bechis-yellow">Horarios</h4>
            <p class="text-white/70">Mar a Dom</p>
            <p class="text-white/70">19:00 – 00:30</p>
        </div>
        <div>
            <h4 class="mb-2 font-semibold text-bechis-yellow">Ubicación</h4>
            <p class="text-white/70">Río Segundo, Córdoba</p>
            <p class="text-white/70">Retiro y envío</p>
        </div>
        <div>
            <h4 class="mb-2 font-semibold text-bechis-yellow">Pedidos</h4>
            <a href="/" class="block text-white/70 transition-colors hover:text-white">Ver catálogo</a>
            <a href="/carrito" class="block text-white/70 transition-colors hover:text-white">Mi carrito</a>
        </div>
        </div>
    </div>

    <div class="mx-auto mt-8 w-full max-w-7xl border-t border-bechis-yellow pt-5 text-xs text-white/40">
        © {currentYear} Bechis. Todos los derechos reservados.
    </div>
</footer>