---
// Cuadro fijo arriba del catálogo: avisa que el carrito tiene productos.
// Solo se muestra en la portada y en las categorías, y solo si hay algo en el carrito.
// Lee el mismo store que el contador del header (src/stores/cart.ts): no guarda nada propio.
// Los ids empiezan con "cart-notice-" para no chocar con los de la página del carrito.
---

<div id="cart-notice-bar" class="mx-auto hidden w-full max-w-7xl px-4 pt-3 md:px-8">
    <div class="flex items-center justify-between gap-3 rounded-xl border border-bechis-yellow bg-bechis-yellow/10 py-2.5 pl-4 pr-2.5">
        <div class="min-w-0">
            <p id="cart-notice-title" class="text-sm font-bold text-white"></p>
            <p id="cart-notice-last" class="truncate text-xs text-white/60"></p>
        </div>
        <div class="flex shrink-0 items-center gap-3">
            <span class="text-right leading-tight">
                <span class="block text-[10px] uppercase tracking-wide text-white/50">Subtotal</span>
                <span id="cart-notice-total" class="block text-sm font-bold tabular-nums text-bechis-yellow"></span>
            </span>
            <a
                href="/carrito"
                class="inline-flex h-11 items-center gap-1.5 rounded-lg bg-bechis-yellow px-4 text-sm font-bold text-ink transition-opacity hover:opacity-90"
            >
                Ver carrito <span aria-hidden="true">→</span>
            </a>
        </div>
    </div>
</div>

<script>
    import { cartItems, cartCount, cartSubtotal } from "@/stores/cart";

    const box = document.getElementById("cart-notice-bar");
    const title = document.getElementById("cart-notice-title");
    const last = document.getElementById("cart-notice-last");
    const total = document.getElementById("cart-notice-total");

    const money = new Intl.NumberFormat("es-AR", { style: "currency", currency: "ARS", maximumFractionDigits: 0 });
    const onCatalog = location.pathname === "/" || location.pathname.startsWith("/categoria");

    function render() {
        if (!box || !title || !last || !total) return;

        const count = cartCount.get();
        if (!onCatalog || count === 0) {
            box.classList.add("hidden");
            return;
        }

        const items = cartItems.get();
        const latest = items[items.length - 1];

        title.textContent = count === 1 ? "Tenés 1 producto en tu carrito" : `Tenés ${count} productos en tu carrito`;
        last.textContent = latest ? `Último agregado: ${latest.productName}` : "";
        total.textContent = money.format(cartSubtotal.get());
        box.classList.remove("hidden");
    }

    cartItems.subscribe(render);
</script>